# Copy to .env (gitignored). Do not put secrets in this file.

UV_PROJECT_ENVIRONMENT=.venv
DQT_LOG_LEVEL=INFO

# One active value each. Last uncommented line wins for Make / direnv.
DQT_DATA_DIR=data
# DQT_DATA_DIR=data/current

# Azure ML: mirror lake parquet to local OS disk for fast DuckDB reads
# DQT_USE_LAKE_MIRROR=1
# DQT_LAKE_MIRROR=~/dqt/etp_lake

# Docker / Azure ML Custom Application (see docker/README.md)
# EXPLAIN_HOST=0.0.0.0
# EXPLAIN_PORT=8765
# EXPLAIN_CACHE_DIR=/cache
# EXPLAIN_BEHIND_PROXY=1

START_DATE=2024-06-01
# START_DATE=2026-08-07

SNOWFLAKE_AUTHENTICATOR=SNOWFLAKE_JWT
SNOWFLAKE_DATABASE=DATA_SCIENCE_WORKSPACE
SNOWFLAKE_SCHEMA=your_schema
# Dial publish target table leaf (FQN = DATABASE.SCHEMA.TABLE). Shadow jobs
# default to workspace schema (e.g. RARKO) with allow_prod=False.
# DQT_DIAL_TABLE=HISTORICAL_ETP_DYNAMIC_QUANTILES
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
