# ETP Explainer Environment Configuration
# Copy to .env and customize. Do not put secrets in this file.

# =============================================================================
# Python Environment
# =============================================================================
UV_PROJECT_ENVIRONMENT=.venv
DQT_LOG_LEVEL=INFO

# =============================================================================
# Data Paths
# =============================================================================
# One active value each. Last uncommented line wins for Make / direnv.

# Local development (default)
DQT_DATA_DIR=data

# VM / production path
# DQT_DATA_DIR=/home/azureuser/cloudfiles/code/Users/rarko/dev/etp-dqt/data

# Symlink to etp-dqt data
# DQT_DATA_DIR=../etp-dqt/data

# =============================================================================
# Azure ML: Lake Mirror (optional, for faster DuckDB reads)
# =============================================================================
# DQT_USE_LAKE_MIRROR=1
# DQT_LAKE_MIRROR=~/dqt/etp_lake

# =============================================================================
# Server Configuration
# =============================================================================
# Host to bind to (127.0.0.1 for local only, 0.0.0.0 for network access)
EXPLAIN_HOST=127.0.0.1

# Port to listen on
EXPLAIN_PORT=8765

# Trust X-Forwarded-* headers from proxy (set to 1 when behind nginx/Azure ML)
EXPLAIN_BEHIND_PROXY=0

# Cache directory for rendered HTML (default: data/explain-shipments)
# EXPLAIN_CACHE_DIR=/cache
# EXPLAIN_CACHE_DIR=/mnt/dqt/etp-explainer-cache

# =============================================================================
# Authentication
# =============================================================================
# Enable basic authentication (set to 0 to disable for local dev ONLY)
AUTH_ENABLED=1

# Basic auth credentials
# Username for basic auth
AUTH_USERNAME=etp

# Password for basic auth (plain text for dev, bcrypt hash for production)
# To generate a bcrypt hash:
#   python -c "from passlib.context import CryptContext; print(CryptContext(schemes=['bcrypt']).hash('your-password'))"
AUTH_PASSWORD=changeme

# Production example (bcrypt hash):
# AUTH_PASSWORD=$2b$12$abcdefghijklmnopqrstuvwxyz1234567890ABCDEFGH

# =============================================================================
# Snowflake (for MDE queries, optional)
# =============================================================================
START_DATE=2024-06-01
# START_DATE=2026-08-07

SNOWFLAKE_AUTHENTICATOR=SNOWFLAKE_JWT
SNOWFLAKE_DATABASE=DATA_SCIENCE_WORKSPACE
SNOWFLAKE_SCHEMA=your_schema
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# Dial publish target table (for other etp tools)
# DQT_DIAL_TABLE=HISTORICAL_ETP_DYNAMIC_QUANTILES
